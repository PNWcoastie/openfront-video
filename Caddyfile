# Caddy gets and renews Let's Encrypt certificates for these names by itself
# and redirects HTTP to HTTPS.
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# Only text types by default; videos and PNGs are already compressed.
	encode zstd gzip
	# The app may hold a request while a game renders (link previewers, video
	# requests), so the proxy must not time out before it answers.
	reverse_proxy app:8080 {
		transport http {
			read_timeout 5m
		}
	}
	log {
		output stdout
		format console
	}
}

# Discord embed timing test (docker compose --profile test). Responses go out
# as they're written (flush_interval -1), so the slow video really trickles.
test.{$DOMAIN} {
	reverse_proxy embedtest:8090 {
		flush_interval -1
		transport http {
			read_timeout 10m
		}
	}
}
