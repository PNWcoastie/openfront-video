# Copy to .env and fill in.
DOMAIN=openfront.video
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com
# Games rendered at the same time (each uses several cores).
MAX_RENDERS=1
# How long link previewers (Discord) are held while a game renders, in seconds.
EMBED_WAIT_SECS=25
# Google AdSense publisher ID (ca-pub-...); empty = no ads. The slot is optional:
# a fixed ad unit under the video, on top of Auto ads.
ADSENSE_CLIENT=
ADSENSE_SLOT=
